# COPÍA ESTE ARCHIVO A .env Y COMPLETÁ CON TUS VALORES REALES
# NUNCA commitees .env con credenciales reales

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API (Whisper)
OPENAI_API_KEY=sk-proj-xxx

# Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=123456789012345
META_ACCESS_TOKEN=your_meta_access_token_here
META_VERIFY_TOKEN=your_verify_token_here
# Recomendado: App Secret (Meta for Developers > tu app > Configuración > Básica)
# Habilita la verificación de firma X-Hub-Signature-256 en /webhook.
META_APP_SECRET=your_app_secret_here
# Recomendado: App ID (Meta for Developers > tu app, aparece arriba junto al
# nombre — "Identificador de la aplicación"). Junto con META_APP_SECRET,
# habilita el chequeo automático cada 15 min de que el webhook siga
# suscripto en Meta (check_webhook_health en main.py).
META_APP_ID=your_app_id_here

# Supabase (base de datos + storage de PDFs/fotos)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=xxx

# FastAPI
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Coordinator notifications
COORDINADOR_TEL=549XXXXXXXXX
