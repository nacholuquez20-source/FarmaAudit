# Supabase Configuration
# Get these values from Supabase dashboard: Settings > API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (public, safe to share)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: API URL (if using REST endpoints)
VITE_API_URL=http://localhost:8000

# Numero del bot de WhatsApp (solo digitos, con codigo de pais).
# Los botones "Auditar por WhatsApp" abren el chat con este numero.
VITE_WHATSAPP_PHONE=5493816199195
